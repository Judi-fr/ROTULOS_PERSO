# Copiar este archivo a .env y completar los valores.
# El archivo .env NO se versiona (está en .gitignore).

# Clave secreta de Django. Generar una con:
#   python -c "from django.utils.crypto import get_random_string; print(get_random_string(50, 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'))"
SECRET_KEY=cambiar-por-una-clave-secreta

# true en desarrollo, false en producción
DEBUG=true

# Hosts permitidos, separados por coma (ej: midominio.com,api.midominio.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes del frontend habilitados para CORS, separados por coma
# (en desarrollo se ignora: dev.py permite todos los orígenes)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Google OAuth / Sign-In ---
# Credenciales del OAuth client "Web application" creado en Google Cloud
# Console (APIs y servicios / Google Auth Platform -> Clients).
# GOOGLE_CLIENT_ID se usa como audience al verificar el ID token (Flujo A).
# GOOGLE_CLIENT_SECRET solo hace falta para el flujo redirect/code (Flujo B).
GOOGLE_CLIENT_ID=cambiar-por-el-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=cambiar-por-el-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/

# --- Email ---
# Para probar el flujo real sin SMTP, deja EMAIL_BACKEND con Console.
# Si quieres mandar correo real, cambia a django.core.mail.backends.smtp.EmailBackend
# y completa las credenciales del proveedor (Gmail, Mailtrap, etc.).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password
DEFAULT_FROM_EMAIL=tu-email@gmail.com
FRONTEND_URL=http://localhost:8001

# Contraseña inicial de las cuentas creadas desde el panel de administración.
ADMIN_CREATED_USER_PASSWORD=cambiar-por-una-clave-temporal-segura

# --- Base de datos (Postgres en Docker) ---
# docker-compose usa estas tres variables para crear el contenedor de la base
# y para armar la DATABASE_URL que recibe la API.
POSTGRES_DB=rotulos
POSTGRES_USER=rotulos
POSTGRES_PASSWORD=cambiar-por-un-password

# Solo para correr Django FUERA de Docker contra el Postgres del contenedor.
# Si se omite, Django usa SQLite local (db.sqlite3).
# DATABASE_URL=postgres://rotulos:cambiar-por-un-password@localhost:5432/rotulos
