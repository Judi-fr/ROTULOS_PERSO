# Copiar este archivo a .env y completar los valores.
# El archivo .env NO se versiona (está en .gitignore).

# Clave secreta de Django. Generar una con:
#   python -c "from django.utils.crypto import get_random_string; print(get_random_string(50, 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'))"
SECRET_KEY=cambiar-por-una-clave-secreta

# true en desarrollo, false en producción
DEBUG=true

# Hosts permitidos, separados por coma (ej: midominio.com,api.midominio.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes del frontend habilitados para CORS, separados por coma
# (en desarrollo se ignora: dev.py permite todos los orígenes).
# http://localhost:8001 / http://127.0.0.1:8001 es donde se sirve el
# frontend estático de este proyecto (ver FRONTEND_URL más abajo).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8001,http://127.0.0.1:8001

# --- Google OAuth / Sign-In ---
# Credenciales del OAuth client "Web application" creado en Google Cloud
# Console (APIs y servicios / Google Auth Platform -> Clients).
# GOOGLE_CLIENT_ID se usa como audience al verificar el ID token (Flujo A).
# GOOGLE_CLIENT_SECRET solo hace falta para el flujo redirect/code (Flujo B).
GOOGLE_CLIENT_ID=cambiar-por-el-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=cambiar-por-el-client-secret
# GOOGLE_REDIRECT_URI no se usa: el login con Google va por GoogleAuthView en
# POST /api/v1/auth/google/, que recibe el ID token directo del frontend
# (Flujo A). Ningún código del proyecto lee esta variable ni existe la ruta
# /api/auth/google/callback/ a la que apunta.
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/

# --- Email ---
# Para probar el flujo real sin SMTP, deja EMAIL_BACKEND con Console.
# Si quieres mandar correo real, cambia a django.core.mail.backends.smtp.EmailBackend
# y completa las credenciales del proveedor (Gmail, Mailtrap, etc.).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password
DEFAULT_FROM_EMAIL=tu-email@gmail.com
FRONTEND_URL=http://localhost:8001

# Contraseña inicial de las cuentas creadas desde el panel de administración.
ADMIN_CREATED_USER_PASSWORD=cambiar-por-una-clave-temporal-segura

# --- Rótulos (render en servidor) ---
# Datos del remitente que se imprimen en todo rótulo generado por el
# backend (apps.labels.rendering): el remitente siempre es Buspack, no
# depende del rótulo/pedido.
LABEL_SENDER_NAME=Buspack
LABEL_SENDER_ADDRESS=Buspack - Encomiendas
# Tope de rótulos por lote (POST /api/v1/labels/batch/): corre síncrono,
# en el mismo request, así que un número muy alto termina en timeout.
LABELS_BATCH_MAX_ITEMS=200

# --- Importación de pedidos (apps.orders, story 21) ---
# Igual criterio que LABELS_BATCH_MAX_ITEMS: corre síncrono.
ORDERS_IMPORT_MAX_ROWS=1000
ORDERS_IMPORT_MAX_FILE_SIZE_MB=10

# --- Ingesta/webhooks (apps.integrations, stories 23-24) ---
# Límite de la API de ingesta autenticada con Api-Key.
INGEST_THROTTLE_RATE=120/min
# Timeout de un envío de webhook saliente: un fallo del cliente nunca debe
# bloquear la operación que lo disparó, así que se corta corto.
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=3

# --- Base de datos (Postgres en Docker) ---
# docker-compose usa estas tres variables para crear el contenedor de la base
# y para armar la DATABASE_URL que recibe la API.
POSTGRES_DB=rotulos
POSTGRES_USER=rotulos
POSTGRES_PASSWORD=cambiar-por-un-password

# Solo para correr Django FUERA de Docker contra el Postgres del contenedor.
# Si se omite, Django usa SQLite local (db.sqlite3).
# DATABASE_URL=postgres://rotulos:cambiar-por-un-password@localhost:5432/rotulos

# --- Email (SMTP) ---
# Envío de correos transaccionales (reset de contraseña). Si se OMITE
# EMAIL_BACKEND, en desarrollo los correos se imprimen en la consola del
# runserver (no se envían). Para envío real, descomentar y completar.
# Con Gmail, EMAIL_HOST_PASSWORD es una "contraseña de aplicación" (16
# caracteres, requiere 2FA activado), NO la clave normal de la cuenta.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=tu-cuenta@gmail.com
# EMAIL_HOST_PASSWORD=cambiar-por-la-app-password
# DEFAULT_FROM_EMAIL=ROTULOS <tu-cuenta@gmail.com>
# FRONTEND_URL=http://localhost:5173
# Base del enlace de reset (por defecto {FRONTEND_URL}/reset-password). Mientras
# no exista el frontend, se puede apuntar a la página de prueba de oauth-test:
# PASSWORD_RESET_URL=http://localhost:3000/reset-password.html
# Base del enlace de verificación de email (por defecto {FRONTEND_URL}/verify-email.html),
# enviado al registrarse con email/contraseña (las cuentas de Google no lo necesitan).
# EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email.html

# --- Producción (config/settings/prod.py, DJANGO_SETTINGS_MODULE=config.settings.prod) ---
# Todas opcionales: ya tienen un default seguro (HTTPS forzado, cookies
# seguras, HSTS de 30 días). Solo hace falta tocarlas para ajustar valores,
# no para activar la seguridad en sí.
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=2592000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Nombre de la cabecera que manda el proxy/balanceador (nginx, etc.) para
# indicar que la conexión original del cliente ya era HTTPS.
# SECURE_PROXY_SSL_HEADER_NAME=HTTP_X_FORWARDED_PROTO

# --- Importación de rótulos por foto / PDF (apps.processing, Claude) ---
# Clave de la API de Anthropic (https://console.anthropic.com -> API Keys).
# Sin ella, la importación de un rótulo devuelve un error claro en vez de
# fallar de forma críptica. NO commitear una clave real.
# ANTHROPIC_API_KEY=sk-ant-...
# Modelo que interpreta el rótulo. Por defecto claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5
# Timeout (segundos) de la llamada a la API de Claude.
# ANTHROPIC_TIMEOUT=120
# Límite de importaciones por usuario por minuto (cada una paga tokens).
# IMPORTACION_THROTTLE_RATE=20/min
